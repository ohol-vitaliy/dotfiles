#!/usr/bin/env sh

case "$1" in
*.mp4 | *.mkv | *.avi | *.webm | *.mov | *.m4v | *.mpg | *.mpeg | *.m4v | *.wmv | *.flv | *.ts)
	exec mpv "$1"
	;;
*.jpg | *.jpeg | *.png | *.gif | *.webp | *.bmp | *.tif | *.tiff | *.avif)
	exec feh "$1"
	;;
*.pdf)
	exec zathura "$1"
	;;
*.sh | *.awk | *.lua | *.txt | *.md | *.css | *.js | *.html | *.py | *.c | *.cpp | *.h | *.hpp | *.sql | *.cgi)
	exec bat --paging=always -- "$1"
	;;
*)
	exec more "$1"
	;;
esac
