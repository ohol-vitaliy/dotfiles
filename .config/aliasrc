if command -v info >/dev/null 2>&1; then
	alias info="info --vi-keys"
fi

if command -v fzf >/dev/null 2>&1; then
	h() {
		eval "$(history | cut -c 8- | uniq | fzf +s --tac)"
	}

	c() {
		# local dir
		dir=$(find -L "${1:-.}" \
			-name .git -prune \
			-o -name .vim -prune \
			-o -type d -print 2>/dev/null |
			fzf --border --preview "ls {}") &&
			cd "$dir" ||
			echo "Cancelling.."
	}

	e() {
		# local file
		# shellcheck disable=SC2016
		file=$(find -L "${1:-.}" \
			-name .git -prune \
			-o -name .cache -prune \
			-o -name .vim -prune \
			-o -name '*.o' -prune \
			-o -name '*.su' -prune \
			-o -name '*.d' -prune \
			-o -name '*.pyc' -prune \
			-o -name '*.elf' -prune \
			-o -name '*.mp3' -prune \
			-o -name '*.ogg' -prune \
			-o -name '*.mp4' -prune \
			-o -name '*.avi' -prune \
			-o -type f -print 2>/dev/null |
			fzf --border --preview \
				'case "$(file --mime {})" in *binary*) echo {} is a binary file;; *) (bat --style=numbers --color=always {} || batcat --style=numbers --color=always {} || highlight -O ansi -l {} || coderay {} || rougify {} || cat {}) 2>/dev/null | head -500;; esac') &&
			$EDITOR "$file" ||
			echo "Cancelling.."
	}

	k() {
		# local pid
		pid="$(ps -eo pid,user,time,comm,args | sed 1d | fzf -m | awk '{print $1}')"

		if [ -n "$pid" ]; then
			# shellcheck disable=SC2086 # unquoted: one PID per line from fzf -m
			kill -"${1:-9}" $pid
		fi
	}
else
	echo "FZF is not installed"
fi

encr() {
	openssl enc -aes-256-cbc -pbkdf2 -in "$1" -out "$1.encr"
}

decr() {
	case "$1" in
	*.encr)
		openssl enc -d -aes-256-cbc -pbkdf2 -in "$1" -out "${1%.encr}"
		;;
	*)
		echo "File does not end with .encr extension"
		;;
	esac
}

# http://www.commandlinefu.com/commands/view/954

# colorize man output
_man_bold=$(printf '\033[01;31m')
_man_end=$(printf '\033[0m')
_man_standout=$(printf '\033[01;44;33m')
_man_underline=$(printf '\033[01;32m')

man() {
	LESS_TERMCAP_mb="$_man_bold" \
		LESS_TERMCAP_md="$_man_bold" \
		LESS_TERMCAP_me="$_man_end" \
		LESS_TERMCAP_se="$_man_end" \
		LESS_TERMCAP_so="$_man_standout" \
		LESS_TERMCAP_ue="$_man_end" \
		LESS_TERMCAP_us="$_man_underline" \
		command man "$@"
}
